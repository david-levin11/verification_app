# Copy into Community Cloud > Advanced settings > Secrets.
# This example is not loaded automatically. No GitHub token is needed for this public asset.
[cloud]
enabled = true
snapshot_id = "test-data-v1"
archive_url = "https://github.com/david-levin11/verification_app/releases/download/test-data-v1/verification-test-data-2026-11.zip"
archive_sha256 = "165ff495f35188ae6095fc0b55dbaef4a7bb708d052f12f7a4cef8502cf6a322"

# Optional overrides, relative to the ZIP root; usually auto-detected.
# model_subdir = "model"
# metadata_file = "metadata/ak_station_metadata.parquet"
# refs_subdir = "derived/refs"
# start_date = "2026-10-01"
# end_date = "2026-10-07"

# For a private data repository, use the release ASSET API URL instead:
# archive_url = "https://api.github.com/repos/OWNER/REPO/releases/assets/ASSET_ID"
# github_token = "READ_ONLY_TOKEN_WITH_ACCESS_TO_THAT_DATA_REPOSITORY"
